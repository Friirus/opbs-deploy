# Fichier facultatif : une instance démarre sans lui.
#
# Les secrets de l'instance (mot de passe de la base, clé de chiffrement, secrets JWT, jeton
# d'installation) ne vont jamais ici. Le service init-secrets les génère au premier
# `docker compose up`, dans des volumes hors de la base (voir apps/api/src/cli/instance-secrets.ts).
# Le script d'installation (infra/install.sh) écrit lui-même DOMAIN et TLS_MODE ; le reste se règle
# dans l'assistant d'installation puis dans le panel (SMTP, paiement, fournisseurs).
#
# Placé à côté du fichier compose, ce fichier est lu automatiquement par Compose :
#   depuis les sources : docker compose -p opbs -f infra/docker-compose.yml up -d
#   depuis les images  : docker compose -p opbs -f docker-compose.images.yml up -d
# (dans le dépôt source, ajouter `--env-file .env` : le fichier est à la racine, pas dans infra/).

# --- Hébergement ---------------------------------------------------------------------------------

# Domaine public de l'instance. Le panel est servi sur admin.<DOMAIN> et la page de statut sur
# status.<DOMAIN> : prévoir les trois enregistrements DNS. Défaut : localhost.
DOMAIN=localhost

# Mode TLS de Caddy, sans effet avec votre propre reverse proxy. Deux valeurs possibles :
#   internal            -> certificat auto-signé, pour localhost ou un domaine de test (opbs.test)
#   contact@exemple.fr  -> certificat Let's Encrypt pour un vrai DOMAIN public, à cette adresse
TLS_MODE=internal

# Reverse proxy fourni (Caddy, ports 80 et 443, TLS automatique). Mettre 0 si vous avez déjà
# nginx/Apache/Traefik sur ce serveur : les 4 applications restent jointes sur 127.0.0.1:3001-3004,
# à vous de les router (exemple de vhost nginx dans DEPLOY.md, section « Reverse proxy »). Un Caddy
# déjà lancé est retiré au `up` suivant.
OPBS_BUNDLED_PROXY=1

# Dossier des modules déposés sur l'instance (FTP/SSH), monté en lecture seule dans l'API et le
# worker. Un chemin relatif est résolu depuis le dossier du fichier compose utilisé, pas depuis le
# répertoire courant — mettre un chemin absolu lève toute ambiguïté.
EXTENSIONS_DIR=./extensions

# Niveau du journal structuré (pino, api + worker) : trace, debug, info, warn, error, fatal
LOG_LEVEL=info

# Clé de chiffrement définitivement perdue (aucune sauvegarde) : mettre 1 le temps d'un démarrage
# pour que l'API accepte la clé en place. Les secrets chiffrés avec l'ancienne (modules,
# fournisseurs, SSO, webhooks, double authentification) sont alors à ressaisir. Laisser vide sinon.
OPBS_ACCEPT_NEW_CREDENTIALS_KEY=

# --- Courrier entrant (facultatif) ---------------------------------------------------------------

# Réponses de ticket par e-mail et détection des bounces : le worker relève périodiquement cette
# boîte IMAP. Laisser IMAP_HOST vide désactive l'ingestion. La boîte doit recevoir les DSN de bounce
# (donc router ici les échecs de livraison de l'adresse d'expédition du module SMTP) et le
# plus-addressing `reply+<token>@<domaine de cette adresse>`. L'envoi, lui, se règle dans le panel
# (Paramètres › Extensions, module SMTP), comme les passerelles de paiement.
IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX

# --- Pièces jointes des tickets (facultatif) -----------------------------------------------------

# Vers S3 ou un stockage compatible S3. Laisser ATTACHMENTS_S3_BUCKET vide = fonctionnalité
# désactivée (pas de bouton d'envoi côté client). Contrairement aux identifiants de BACKUP_S3_*
# ci-dessous, ceux-ci DOIVENT être ici : l'API et le worker y accèdent au runtime du conteneur.
ATTACHMENTS_S3_BUCKET=
ATTACHMENTS_S3_REGION=eu-west-3
ATTACHMENTS_S3_ACCESS_KEY_ID=
ATTACHMENTS_S3_SECRET_ACCESS_KEY=
# Vide = AWS S3. Renseigner pour un stockage compatible S3 (ex: https://s3.fr-par.scw.cloud).
ATTACHMENTS_S3_ENDPOINT_URL=

# --- Sauvegardes hors site (facultatif) ----------------------------------------------------------

# Copie des sauvegardes (infra/backup.sh et infra/restore.sh) vers S3 ou un stockage compatible S3
# (MinIO, Backblaze B2, OVH...). Laisser vide = sauvegarde locale uniquement. Les identifiants AWS
# (AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_DEFAULT_REGION) ne vont PAS ici : les exporter dans
# l'environnement qui lance backup.sh (ex: le crontab), pas dans .env.
BACKUP_S3_BUCKET=
# Vide = AWS S3. Renseigner pour un stockage compatible S3 (ex: https://s3.fr-par.scw.cloud).
BACKUP_S3_ENDPOINT_URL=

# --- Développement local (pnpm dev, hors Docker) -------------------------------------------------

# Ignorées par les fichiers compose, qui fixent ces valeurs pour les conteneurs. `pnpm dev:env`
# complète votre .env de développement : ces lignes, plus des secrets générés pour la machine
# (POSTGRES_PASSWORD, DATABASE_URL, clé de chiffrement, secrets JWT, jeton d'installation).
REDIS_URL=redis://localhost:6379
WEB_PORTAL_URL=http://localhost:3003
WEB_ADMIN_URL=http://localhost:3002
# URL publique de la page de statut, remise aux thèmes pour un lien de pied de page. Vide = aucun
# lien. En Docker, dérivée de DOMAIN (status.<DOMAIN>).
STATUS_PAGE_URL=http://localhost:3004
# Chemin *hôte* où le worker écrit l'instantané public que status-page lit (toujours
# /snapshot/status.json dans les conteneurs).
STATUS_SNAPSHOT_PATH=/tmp/opbs-status-snapshot.json
