# Copier en .env avant de démarrer la pile, à côté du fichier compose de votre déploiement :
#   depuis les sources     : docker compose -p opbs -f infra/docker-compose.yml --env-file .env up -d
#   depuis les images      : docker compose -p opbs -f docker-compose.images.yml --env-file .env up -d

POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql://opbs:changeme@postgres:5432/opbs?schema=public
REDIS_URL=redis://redis:6379

# Niveau du journal structuré (pino, api + worker) : trace, debug, info, warn, error, fatal
LOG_LEVEL=info

# Clé maître de chiffrement des credentials Proxmox (AES-256-GCM) — générer avec: openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY=

# Secrets JWT — distincts entre staff et clients finaux pour qu'un token ne puisse jamais servir dans l'autre contexte.
# Générer avec: openssl rand -base64 48
JWT_STAFF_SECRET=
JWT_CUSTOMER_SECRET=
JWT_IMPERSONATION_EXCHANGE_SECRET=
JWT_SSO_TICKET_SECRET=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# URL publique du portail client, utilisée pour construire les redirections Stripe Checkout après paiement
# et les liens de réinitialisation de mot de passe envoyés par email.
WEB_PORTAL_URL=http://localhost:3003
# URL publique du back-office, utilisée pour construire les liens de réinitialisation de mot de passe staff.
WEB_ADMIN_URL=http://localhost:3002
# URL publique de la page de statut (apps/status-page), remise aux thèmes pour un lien de pied de
# page. Vide = aucun lien. En déploiement Docker, dérivée de DOMAIN (status.<DOMAIN>) comme les deux
# URL ci-dessus : cette ligne ne sert qu'au développement local.
STATUS_PAGE_URL=http://localhost:3004

# Email transactionnel (confirmations de commande, relances impayés). Laisser vide en dev:
# les emails sont alors juste affichés dans les logs du worker/API au lieu d'être envoyés.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.test

# Courrier entrant (réponses de ticket par email, détection des bounces) : le worker relève
# périodiquement cette boîte IMAP. Laisser IMAP_HOST vide désactive l'ingestion, comme SMTP_HOST
# vide désactive l'envoi. La boîte doit recevoir les DSN de bounce (donc router les échecs de
# livraison de SMTP_FROM ici) et le plus-addressing `reply+<token>@<domaine de SMTP_FROM>`.
IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX

# Domaine public de l'instance, utilisé par le reverse proxy (Caddy) pour le TLS automatique.
# Le back-office est servi sur admin.<DOMAIN> : prévoir les deux enregistrements DNS.
DOMAIN=localhost

# Reverse proxy : le profil `bundled-proxy` démarre le Caddy fourni, qui prend les ports 80 et 443
# et gère le TLS tout seul. Vider cette variable si vous avez déjà nginx/Apache/Traefik sur ce
# serveur : les 4 applications restent alors accessibles sur 127.0.0.1:3001-3004, à vous de les
# router (exemple de vhost nginx dans DEPLOY.md, section « Reverse proxy »). Équivalent en ligne de
# commande : `docker compose --profile bundled-proxy ...`.
# Piège si l'instance tourne déjà avec Caddy : vider cette variable ne l'arrête pas — Compose
# ignore un conteneur de profil désactivé au lieu de le supprimer, `down` compris. Le retirer une
# fois avec `--profile bundled-proxy down`, sinon il garde les ports 80/443. Voir DEPLOY.md.
COMPOSE_PROFILES=bundled-proxy

# Mode TLS de Caddy, sans effet si vous fournissez votre propre reverse proxy (ci-dessus).
# Deux valeurs possibles, jamais vide :
#   internal            -> certificat auto-signé, pour localhost ou un domaine de test (opbs.test)
#   contact@exemple.fr  -> certificat Let's Encrypt pour un vrai DOMAIN public, à cette adresse
TLS_MODE=internal

# Dossier des modules déposés sur l'instance (FTP/SSH), monté en lecture seule dans l'API et le
# worker. Un chemin relatif est résolu depuis le dossier du fichier compose utilisé, pas depuis le
# répertoire courant — mettre un chemin absolu lève toute ambiguïté.
EXTENSIONS_DIR=./extensions

# Chemin *hôte* où le worker écrit l'instantané public (nœuds/incidents) que status-page lit.
# Câblé en dur côté conteneurs (toujours /snapshot/status.json en interne) : ne concerne que
# l'exécution hors Docker (pnpm dev).
STATUS_SNAPSHOT_PATH=/tmp/opbs-status-snapshot.json

# Copie hors-site des sauvegardes (infra/backup.sh et infra/restore.sh), vers S3 ou un stockage
# compatible S3 (MinIO, Backblaze B2, OVH...). Laisser vide = sauvegarde locale uniquement.
# Les identifiants AWS (AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_DEFAULT_REGION) ne vont PAS
# ici : les exporter dans l'environnement qui lance backup.sh (ex: le crontab), pas dans .env.
BACKUP_S3_BUCKET=
# Vide = AWS S3. Renseigner pour un stockage compatible S3 (ex: https://s3.fr-par.scw.cloud).
BACKUP_S3_ENDPOINT_URL=

# Pièces jointes des tickets de support, vers S3 ou un stockage compatible S3. Laisser
# ATTACHMENTS_S3_BUCKET vide = fonctionnalité désactivée (pas de bouton d'envoi côté client).
# Contrairement aux identifiants de BACKUP_S3_* ci-dessus, ceux-ci DOIVENT être ici : l'API et le
# worker y accèdent au runtime du conteneur, pas via un script lancé depuis l'hôte.
ATTACHMENTS_S3_BUCKET=
ATTACHMENTS_S3_REGION=eu-west-3
ATTACHMENTS_S3_ACCESS_KEY_ID=
ATTACHMENTS_S3_SECRET_ACCESS_KEY=
# Vide = AWS S3. Renseigner pour un stockage compatible S3 (ex: https://s3.fr-par.scw.cloud).
ATTACHMENTS_S3_ENDPOINT_URL=
